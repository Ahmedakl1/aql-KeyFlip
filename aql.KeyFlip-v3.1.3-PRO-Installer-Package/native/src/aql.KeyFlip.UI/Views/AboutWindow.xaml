<Window x:Class="aql.KeyFlip.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About aql.KeyFlip"
        Height="360" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="aql.KeyFlip" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Keyboard Layout Converter" 
                       FontSize="11" 
                       Foreground="{StaticResource PrimarySkyBrush}" 
                       HorizontalAlignment="Center" 
                       Margin="0,2,0,4"/>
            <Border Background="#1F2937" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                <TextBlock Text="&quot;Type Wrong. Flip. Continue.&quot;" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>

        <!-- Details Card -->
        <Border Grid.Row="1" 
                Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="14,10"
                Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Version:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Name="VersionTextBlock" 
                               Text="v3.1.3" 
                               DockPanel.Dock="Right" 
                               HorizontalAlignment="Right" 
                               Foreground="{StaticResource SuccessGreenBrush}" 
                               FontFamily="Consolas" 
                               FontWeight="Bold" 
                               FontSize="11"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Developed by:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="Eng. Ahmed Salah Aql" 
                               DockPanel.Dock="Right" 
                               HorizontalAlignment="Right" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontWeight="Medium" 
                               FontSize="11"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Brand:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="AQL" 
                               DockPanel.Dock="Right" 
                               HorizontalAlignment="Right" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontWeight="Medium" 
                               FontSize="11"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Motto:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="Building Ideas Into Software" 
                               DockPanel.Dock="Right" 
                               HorizontalAlignment="Right" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="11"/>
                </DockPanel>

                <DockPanel>
                    <TextBlock Text="Country:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Text="🇪🇬 Egypt" 
                               DockPanel.Dock="Right" 
                               HorizontalAlignment="Right" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="11"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="2" 
                Click="OnCloseClick" 
                HorizontalAlignment="Center" 
                Width="100" 
                FontWeight="SemiBold">
            Close
        </Button>
    </Grid>
</Window>
