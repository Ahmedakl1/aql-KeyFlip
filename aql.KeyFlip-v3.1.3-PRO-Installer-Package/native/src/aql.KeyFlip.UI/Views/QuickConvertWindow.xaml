<Window x:Class="aql.KeyFlip.UI.Views.QuickConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Convert - aql.KeyFlip"
        Height="360" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Quick Text Convert" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TextPrimaryBrush}" 
                   Margin="0,0,0,8"/>

        <!-- Preset buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Try:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button Content="hgsl lrd" Click="OnPresetClick" Margin="0,0,4,0" Padding="6,2" FontSize="10"/>
            <Button Content="السلام عليكم" Click="OnPresetClick" Margin="0,0,4,0" Padding="6,2" FontSize="10"/>
            <Button Content="hglslhk ugd;l" Click="OnPresetClick" Margin="0,0,4,0" Padding="6,2" FontSize="10"/>
        </StackPanel>

        <!-- Input -->
        <TextBox Grid.Row="2" 
                 Name="InputTextBox" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 Background="#111827" 
                 Foreground="{StaticResource TextPrimaryBrush}" 
                 BorderBrush="{StaticResource BorderBrush}" 
                 Padding="8" 
                 FontFamily="Consolas" 
                 FontSize="12"
                 TextChanged="OnInputTextChanged"/>

        <!-- Action Row -->
        <DockPanel Grid.Row="3" Margin="0,8">
            <ComboBox Name="QuickModeComboBox" Width="140" FontSize="11" SelectionChanged="OnModeChanged">
                <ComboBoxItem Content="Auto Detect" IsSelected="True"/>
                <ComboBoxItem Content="English → Arabic"/>
                <ComboBoxItem Content="Arabic → English"/>
            </ComboBox>
            <Button DockPanel.Dock="Right" 
                    HorizontalAlignment="Right" 
                    Content="Flip Now" 
                    Click="OnFlipClick" 
                    Background="{StaticResource PrimarySkyBrush}" 
                    BorderBrush="{StaticResource PrimarySkyHoverBrush}" 
                    Foreground="White" 
                    FontWeight="SemiBold"/>
        </DockPanel>

        <!-- Output -->
        <TextBox Grid.Row="4" 
                 Name="OutputTextBox" 
                 IsReadOnly="True" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 Background="#0F172A" 
                 Foreground="{StaticResource PrimarySkyBrush}" 
                 BorderBrush="{StaticResource BorderBrush}" 
                 Padding="8" 
                 FontFamily="Consolas" 
                 FontSize="12"/>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <Button Content="Copy Output" 
                    Click="OnCopyClick" 
                    Background="#1E293B" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    Foreground="{StaticResource TextPrimaryBrush}" 
                    FontSize="11"/>
            <Button DockPanel.Dock="Right" 
                    HorizontalAlignment="Right" 
                    Content="Close" 
                    Click="OnCloseClick" 
                    FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
